{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/movies/:path*",
      "destination": "https://filmes-plataformas-filmes.duckdns.org/:path*"
    },
    {
      "source": "/api/users/:path*",
      "destination": "https://user-plataformas-filmes.duckdns.org/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}
